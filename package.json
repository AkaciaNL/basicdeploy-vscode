{
  "name": "basicdeploy",
  "displayName": "BasicDeploy",
  "description": "Deploy and manage your BasicDeploy apps without leaving VS Code. Ship the current workspace in one click, browse containers, databases, object storage and Kafka, stream logs, open a public URL, and SSH straight into your box. Native GitHub Copilot tools and an @basicdeploy chat participant let the agent build, deploy and debug for you.",
  "version": "0.7.8",
  "publisher": "akacianl",
  "license": "MIT",
  "icon": "media/icon.png",
  "galleryBanner": {
    "color": "#2563EB",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/AkaciaNL/basicdeploy-vscode.git"
  },
  "homepage": "https://basicdeploy.com",
  "bugs": {
    "url": "https://github.com/AkaciaNL/basicdeploy-vscode/issues"
  },
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "AI",
    "Chat",
    "Other"
  ],
  "keywords": [
    "deploy",
    "hosting",
    "paas",
    "copilot",
    "mcp",
    "agent"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "authentication": [
      {
        "id": "basicdeploy",
        "label": "BasicDeploy"
      }
    ],
    "configuration": {
      "title": "BasicDeploy",
      "properties": {
        "basicdeploy.apiUrl": {
          "type": "string",
          "default": "https://basicdeploy.com/api",
          "description": "Base URL of the BasicDeploy REST API."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "basicdeploy",
          "title": "BasicDeploy",
          "icon": "media/icon.svg"
        }
      ]
    },
    "views": {
      "basicdeploy": [
        {
          "id": "basicdeploy.account",
          "name": "Account"
        },
        {
          "id": "basicdeploy.containers",
          "name": "Containers"
        },
        {
          "id": "basicdeploy.database",
          "name": "Database",
          "visibility": "collapsed"
        },
        {
          "id": "basicdeploy.storage",
          "name": "Storage",
          "visibility": "collapsed"
        },
        {
          "id": "basicdeploy.kafka",
          "name": "Kafka",
          "visibility": "collapsed"
        },
        {
          "id": "basicdeploy.domains",
          "name": "Domains",
          "visibility": "collapsed"
        },
        {
          "id": "basicdeploy.support",
          "name": "Support",
          "visibility": "collapsed"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "basicdeploy.account",
        "when": "!basicdeploy.signedIn",
        "contents": "[Sign in to BasicDeploy](command:basicdeploy.signIn) to see your plan and limits."
      },
      {
        "view": "basicdeploy.containers",
        "when": "!basicdeploy.signedIn",
        "contents": "Sign in to see and deploy your BasicDeploy containers.\n[Sign in to BasicDeploy](command:basicdeploy.signIn)\n\nGet an API key at [basicdeploy.com/api-keys](https://basicdeploy.com/api-keys)."
      },
      {
        "view": "basicdeploy.containers",
        "when": "basicdeploy.signedIn",
        "contents": "No containers yet.\n[Deploy current workspace](command:basicdeploy.deployWorkspace)\n[New container](command:basicdeploy.createContainer)"
      },
      {
        "view": "basicdeploy.database",
        "when": "!basicdeploy.signedIn",
        "contents": "[Sign in to BasicDeploy](command:basicdeploy.signIn) to browse your database."
      },
      {
        "view": "basicdeploy.storage",
        "when": "!basicdeploy.signedIn",
        "contents": "[Sign in to BasicDeploy](command:basicdeploy.signIn) to browse your object storage."
      },
      {
        "view": "basicdeploy.kafka",
        "when": "!basicdeploy.signedIn",
        "contents": "[Sign in to BasicDeploy](command:basicdeploy.signIn) to manage your Kafka topics."
      },
      {
        "view": "basicdeploy.domains",
        "when": "!basicdeploy.signedIn",
        "contents": "[Sign in to BasicDeploy](command:basicdeploy.signIn) to manage custom domains."
      },
      {
        "view": "basicdeploy.support",
        "when": "!basicdeploy.signedIn",
        "contents": "[Sign in to BasicDeploy](command:basicdeploy.signIn) to open a support ticket."
      },
      {
        "view": "basicdeploy.support",
        "when": "basicdeploy.signedIn",
        "contents": "No support tickets yet.\n[New support ticket](command:basicdeploy.newTicket)"
      }
    ],
    "commands": [
      { "command": "basicdeploy.signIn", "title": "BasicDeploy: Sign In" },
      { "command": "basicdeploy.signOut", "title": "BasicDeploy: Sign Out" },
      { "command": "basicdeploy.refreshAccount", "title": "BasicDeploy: Refresh Account", "icon": "$(refresh)" },
      { "command": "basicdeploy.managePlan", "title": "BasicDeploy: Manage Plan and Billing", "icon": "$(link-external)" },
      { "command": "basicdeploy.refresh", "title": "BasicDeploy: Refresh", "icon": "$(refresh)" },
      { "command": "basicdeploy.deployWorkspace", "title": "BasicDeploy: Deploy Current Workspace", "icon": "$(rocket)" },
      { "command": "basicdeploy.createContainer", "title": "BasicDeploy: New Container", "icon": "$(add)" },
      { "command": "basicdeploy.wake", "title": "BasicDeploy: Wake Container", "icon": "$(play)" },
      { "command": "basicdeploy.sleep", "title": "BasicDeploy: Sleep Container", "icon": "$(debug-pause)" },
      { "command": "basicdeploy.delete", "title": "BasicDeploy: Delete Container", "icon": "$(trash)" },
      { "command": "basicdeploy.openUrl", "title": "BasicDeploy: Open Public URL", "icon": "$(globe)" },
      { "command": "basicdeploy.viewLogs", "title": "BasicDeploy: View Logs", "icon": "$(output)" },
      { "command": "basicdeploy.streamLogs", "title": "BasicDeploy: Stream Logs (Live)", "icon": "$(pulse)" },
      { "command": "basicdeploy.deployToContainer", "title": "BasicDeploy: Deploy Workspace Into This Container" },
      { "command": "basicdeploy.openSsh", "title": "BasicDeploy: Open Remote SSH", "icon": "$(remote)" },
      { "command": "basicdeploy.refreshDomains", "title": "BasicDeploy: Refresh Domains", "icon": "$(refresh)" },
      { "command": "basicdeploy.addDomain", "title": "BasicDeploy: Add Custom Domain", "icon": "$(add)" },
      { "command": "basicdeploy.removeDomain", "title": "BasicDeploy: Remove Custom Domain", "icon": "$(trash)" },
      { "command": "basicdeploy.refreshDatabase", "title": "BasicDeploy: Refresh Database", "icon": "$(refresh)" },
      { "command": "basicdeploy.openTable", "title": "BasicDeploy: Browse Table" },
      { "command": "basicdeploy.loadMoreTables", "title": "BasicDeploy: Load More Tables" },
      { "command": "basicdeploy.refreshStorage", "title": "BasicDeploy: Refresh Storage", "icon": "$(refresh)" },
      { "command": "basicdeploy.openObject", "title": "BasicDeploy: Open Object" },
      { "command": "basicdeploy.downloadObject", "title": "BasicDeploy: Download Object", "icon": "$(cloud-download)" },
      { "command": "basicdeploy.loadMoreObjects", "title": "BasicDeploy: Load More Objects" },
      { "command": "basicdeploy.refreshKafka", "title": "BasicDeploy: Refresh Kafka", "icon": "$(refresh)" },
      { "command": "basicdeploy.createTopic", "title": "BasicDeploy: New Kafka Topic", "icon": "$(add)" },
      { "command": "basicdeploy.purgeTopic", "title": "BasicDeploy: Purge Topic" },
      { "command": "basicdeploy.deleteTopic", "title": "BasicDeploy: Delete Topic", "icon": "$(trash)" },
      { "command": "basicdeploy.copyConnectionInfo", "title": "BasicDeploy: Copy Connection Info", "icon": "$(key)" },
      { "command": "basicdeploy.newTicket", "title": "BasicDeploy: New Support Ticket", "icon": "$(add)" },
      { "command": "basicdeploy.refreshSupport", "title": "BasicDeploy: Refresh Support", "icon": "$(refresh)" },
      { "command": "basicdeploy.openTicket", "title": "BasicDeploy: Open Support Ticket" },
      { "command": "basicdeploy.replyTicket", "title": "BasicDeploy: Reply to Ticket", "icon": "$(reply)" },
      { "command": "basicdeploy.closeTicket", "title": "BasicDeploy: Close Ticket", "icon": "$(check)" },
      { "command": "basicdeploy.reopenTicket", "title": "BasicDeploy: Reopen Ticket", "icon": "$(history)" },
      { "command": "basicdeploy.openAttachment", "title": "BasicDeploy: Open Ticket Attachment", "icon": "$(file-media)" },
      { "command": "basicdeploy.tableNextPage", "title": "BasicDeploy: Table Next Page", "icon": "$(arrow-right)" },
      { "command": "basicdeploy.tablePrevPage", "title": "BasicDeploy: Table Previous Page", "icon": "$(arrow-left)" }
    ],
    "menus": {
      "view/title": [
        { "command": "basicdeploy.managePlan", "when": "view == basicdeploy.account", "group": "navigation@1" },
        { "command": "basicdeploy.refreshAccount", "when": "view == basicdeploy.account", "group": "navigation@2" },
        { "command": "basicdeploy.deployWorkspace", "when": "view == basicdeploy.containers", "group": "navigation@1" },
        { "command": "basicdeploy.createContainer", "when": "view == basicdeploy.containers", "group": "navigation@2" },
        { "command": "basicdeploy.refresh", "when": "view == basicdeploy.containers", "group": "navigation@3" },
        { "command": "basicdeploy.copyConnectionInfo", "when": "view == basicdeploy.database", "group": "navigation@1" },
        { "command": "basicdeploy.refreshDatabase", "when": "view == basicdeploy.database", "group": "navigation@2" },
        { "command": "basicdeploy.refreshStorage", "when": "view == basicdeploy.storage", "group": "navigation@1" },
        { "command": "basicdeploy.createTopic", "when": "view == basicdeploy.kafka", "group": "navigation@1" },
        { "command": "basicdeploy.refreshKafka", "when": "view == basicdeploy.kafka", "group": "navigation@2" },
        { "command": "basicdeploy.refreshDomains", "when": "view == basicdeploy.domains", "group": "navigation@1" },
        { "command": "basicdeploy.newTicket", "when": "view == basicdeploy.support", "group": "navigation@1" },
        { "command": "basicdeploy.refreshSupport", "when": "view == basicdeploy.support", "group": "navigation@2" }
      ],
      "view/item/context": [
        { "command": "basicdeploy.openUrl", "when": "view == basicdeploy.containers && viewItem =~ /^bdContainer/", "group": "inline@1" },
        { "command": "basicdeploy.wake", "when": "view == basicdeploy.containers && viewItem == bdContainerSleeping", "group": "inline@2" },
        { "command": "basicdeploy.sleep", "when": "view == basicdeploy.containers && viewItem == bdContainerRunning", "group": "inline@2" },
        { "command": "basicdeploy.streamLogs", "when": "view == basicdeploy.containers && viewItem =~ /^bdContainer/", "group": "inline@3" },
        { "command": "basicdeploy.openSsh", "when": "view == basicdeploy.containers && viewItem =~ /^bdContainer/", "group": "inline@4" },
        { "command": "basicdeploy.delete", "when": "view == basicdeploy.containers && viewItem =~ /^bdContainer/", "group": "inline@5" },
        { "command": "basicdeploy.deployToContainer", "when": "view == basicdeploy.containers && viewItem =~ /^bdContainer/", "group": "1_deploy@1" },
        { "command": "basicdeploy.viewLogs", "when": "view == basicdeploy.containers && viewItem =~ /^bdContainer/", "group": "1_deploy@2" },
        { "command": "basicdeploy.openUrl", "when": "view == basicdeploy.containers && viewItem =~ /^bdContainer/", "group": "2_open@1" },
        { "command": "basicdeploy.openSsh", "when": "view == basicdeploy.containers && viewItem =~ /^bdContainer/", "group": "2_open@2" },
        { "command": "basicdeploy.wake", "when": "view == basicdeploy.containers && viewItem == bdContainerSleeping", "group": "3_power@1" },
        { "command": "basicdeploy.sleep", "when": "view == basicdeploy.containers && viewItem == bdContainerRunning", "group": "3_power@2" },
        { "command": "basicdeploy.delete", "when": "view == basicdeploy.containers && viewItem =~ /^bdContainer/", "group": "9_danger" },
        { "command": "basicdeploy.addDomain", "when": "view == basicdeploy.domains && viewItem == bdDomainContainer", "group": "inline@1" },
        { "command": "basicdeploy.removeDomain", "when": "view == basicdeploy.domains && viewItem == bdDomainItem", "group": "inline@1" },
        { "command": "basicdeploy.purgeTopic", "when": "view == basicdeploy.kafka && viewItem == bdTopic", "group": "1_topic@1" },
        { "command": "basicdeploy.deleteTopic", "when": "view == basicdeploy.kafka && viewItem == bdTopic", "group": "9_danger" },
        { "command": "basicdeploy.replyTicket", "when": "view == basicdeploy.support && viewItem == bdTicketOpen", "group": "inline@1" },
        { "command": "basicdeploy.closeTicket", "when": "view == basicdeploy.support && viewItem == bdTicketOpen", "group": "inline@2" },
        { "command": "basicdeploy.reopenTicket", "when": "view == basicdeploy.support && viewItem == bdTicketClosed", "group": "inline@1" },
        { "command": "basicdeploy.downloadObject", "when": "view == basicdeploy.storage && viewItem == bdObject", "group": "inline@1" },
        { "command": "basicdeploy.downloadObject", "when": "view == basicdeploy.storage && viewItem == bdObject", "group": "1_object@1" }
      ],
      "editor/title": [
        { "command": "basicdeploy.tablePrevPage", "when": "resourceScheme == bd-rows", "group": "navigation@1" },
        { "command": "basicdeploy.tableNextPage", "when": "resourceScheme == bd-rows", "group": "navigation@2" },
        { "command": "basicdeploy.replyTicket", "when": "resourceScheme == bd-ticket", "group": "navigation@1" },
        { "command": "basicdeploy.openAttachment", "when": "resourceScheme == bd-ticket", "group": "navigation@2" },
        { "command": "basicdeploy.closeTicket", "when": "resourceScheme == bd-ticket", "group": "navigation@3" },
        { "command": "basicdeploy.reopenTicket", "when": "resourceScheme == bd-ticket", "group": "navigation@4" }
      ]
    },
    "keybindings": [
      {
        "command": "basicdeploy.tableNextPage",
        "key": "alt+right",
        "when": "resourceScheme == bd-rows && editorTextFocus"
      },
      {
        "command": "basicdeploy.tablePrevPage",
        "key": "alt+left",
        "when": "resourceScheme == bd-rows && editorTextFocus"
      }
    ],
    "languageModelTools": [
      {
        "name": "basicdeploy_list_containers",
        "displayName": "List BasicDeploy containers",
        "modelDescription": "List the signed-in user's BasicDeploy containers with their status and public URL.",
        "toolReferenceName": "bdContainers",
        "canBeReferencedInPrompt": true,
        "icon": "$(server)",
        "tags": ["basicdeploy"],
        "inputSchema": { "type": "object", "properties": {} }
      },
      {
        "name": "basicdeploy_deploy_workspace",
        "displayName": "Deploy workspace to BasicDeploy",
        "modelDescription": "Package the current VS Code workspace folder and deploy it to BasicDeploy. Optionally deploy into an existing container by its subdomain; otherwise a new container is created. Returns the container's public URL.",
        "tags": ["basicdeploy"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "subdomain": {
              "type": "string",
              "description": "Optional subdomain of an existing container to deploy into. Omit to create a new container."
            }
          }
        }
      },
      {
        "name": "basicdeploy_logs",
        "displayName": "Read BasicDeploy container logs",
        "modelDescription": "Read the recent logs of a BasicDeploy container by its subdomain, to diagnose why an app is failing.",
        "canBeReferencedInPrompt": true,
        "toolReferenceName": "bdLogs",
        "icon": "$(output)",
        "tags": ["basicdeploy"],
        "inputSchema": {
          "type": "object",
          "properties": {
            "subdomain": { "type": "string", "description": "Subdomain of the container." },
            "tail": { "type": "number", "description": "Number of trailing log lines (default 200)." }
          },
          "required": ["subdomain"]
        }
      }
    ],
    "chatParticipants": [
      {
        "id": "basicdeploy.chat",
        "name": "basicdeploy",
        "fullName": "BasicDeploy",
        "description": "Deploy and manage your BasicDeploy apps and containers",
        "isSticky": true,
        "commands": [
          { "name": "deploy", "description": "Deploy the current workspace" },
          { "name": "logs", "description": "Show a container's recent logs" },
          { "name": "new", "description": "Create a new container" },
          { "name": "list", "description": "List your containers" }
        ]
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "tsc --noEmit -p ./"
  },
  "dependencies": {
    "tar": "^7.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.95.0",
    "@types/tar": "^6.1.13",
    "typescript": "^5.6.0"
  }
}
